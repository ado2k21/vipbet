/* =====================================================================
   VIP BETCOTE — Module commun paiement prestataire (PLOP PLOP)
   ---------------------------------------------------------------------
   Aucune dependance npm : appels PostgREST et prestataire en fetch natif
   (Node 18+ sur Netlify). Ce fichier vit dans lib/ et n'est donc JAMAIS
   deploye comme fonction Netlify (une fonction doit porter le nom de son
   dossier) — il est uniquement require() par les trois handlers.

   Regle de securite centrale de ce module :
   le montant reellement attendu ne vient JAMAIS du navigateur. Il est lu
   en base (payments.expected_amount_htg, ecrit cote serveur) et revalide
   une seconde fois dans la RPC confirmer_paiement_prestataire.
   ===================================================================== */

'use strict';

const crypto = require('crypto');

/* --------------------------------------------------------------------
   Configuration
   -------------------------------------------------------------------- */

/* Correctif historique du projet (20/08) : SUPABASE_URL a deja ete
   renseignee avec « /rest/v1/ » colle au bout sur Netlify, ce qui cassait
   toutes les requetes (PGRST125). On nettoie donc defensivement ici. */
function nettoyerUrlSupabase(brut) {
  if (!brut) return '';
  return String(brut).trim().replace(/\/+$/, '').replace(/\/rest\/v1$/i, '');
}

function lireConfig() {
  const cfg = {
    supabaseUrl: nettoyerUrlSupabase(process.env.SUPABASE_URL),
    serviceKey: (process.env.SUPABASE_SERVICE_ROLE_KEY || '').trim(),
    /* Aucune valeur de repli codee en dur ici, VOLONTAIREMENT : le scanner
       de secrets de Netlify cherche la VALEUR de chaque variable d'env dans
       les fichiers publies et ferait echouer le build en la retrouvant dans
       ce bundle (meme famille de faux positif que SECRETS_SCAN_OMIT_KEYS,
       voir netlify.toml). La variable est donc obligatoire. */
    ppBaseUrl: (process.env.PLOPPLOP_BASE_URL || '').trim().replace(/\/+$/, ''),
    ppClientId: (process.env.PLOPPLOP_CLIENT_ID || '').trim(),
    /* Variables de test optionnelles. Absentes = mode normal.
       Elles ne s'appliquent QU'A un seul UUID precis, jamais globalement. */
    testUserId: (process.env.PLOPPLOP_TEST_USER_ID || '').trim(),
    testAmount: parseInt(process.env.PLOPPLOP_TEST_AMOUNT || '0', 10) || 0,
    /* Duree de vie d'un paiement en attente. Passe ce delai, la ligne est
       liberee : sans cela l'index unique idx_un_seul_paiement_pending_par_user
       bloquerait definitivement quelqu'un ayant ferme la page du prestataire. */
    dureeVieMinutes: parseInt(process.env.PLOPPLOP_PENDING_TTL_MIN || '45', 10) || 45
  };
  const manquantes = [];
  if (!cfg.supabaseUrl) manquantes.push('SUPABASE_URL');
  if (!cfg.serviceKey) manquantes.push('SUPABASE_SERVICE_ROLE_KEY');
  if (!cfg.ppClientId) manquantes.push('PLOPPLOP_CLIENT_ID');
  if (!cfg.ppBaseUrl) manquantes.push('PLOPPLOP_BASE_URL');
  cfg.manquantes = manquantes;
  return cfg;
}

const METHODES_AUTORISEES = ['moncash', 'natcash'];
const MONTANT_MINIMUM_PRESTATAIRE = 20; // impose par l'API : montant >= 20 HTG

/* --------------------------------------------------------------------
   Utilitaires HTTP
   -------------------------------------------------------------------- */

async function fetchAvecDelai(url, options, msDelai) {
  const ctrl = new AbortController();
  const minuteur = setTimeout(() => ctrl.abort(), msDelai || 15000);
  try {
    return await fetch(url, Object.assign({}, options, { signal: ctrl.signal }));
  } finally {
    clearTimeout(minuteur);
  }
}

function reponseJson(statut, corps) {
  return {
    statusCode: statut,
    headers: {
      'Content-Type': 'application/json; charset=utf-8',
      'Cache-Control': 'no-store'
    },
    body: JSON.stringify(corps)
  };
}

/* --------------------------------------------------------------------
   Acces Supabase (service_role — contourne RLS, donc jamais expose au client)
   -------------------------------------------------------------------- */

async function sbRequete(cfg, chemin, options) {
  options = options || {};
  const entetes = Object.assign({
    apikey: cfg.serviceKey,
    Authorization: 'Bearer ' + cfg.serviceKey,
    'Content-Type': 'application/json'
  }, options.headers || {});

  const rep = await fetchAvecDelai(cfg.supabaseUrl + chemin, {
    method: options.method || 'GET',
    headers: entetes,
    body: options.body ? JSON.stringify(options.body) : undefined
  }, options.timeout || 15000);

  const texte = await rep.text();
  let json = null;
  if (texte) { try { json = JSON.parse(texte); } catch (e) { json = null; } }
  if (!rep.ok) {
    const err = new Error('Supabase ' + rep.status + ' sur ' + chemin + ' : ' + texte.slice(0, 400));
    err.httpStatus = rep.status;
    err.corps = json;
    throw err;
  }
  return json;
}

function sbSelect(cfg, table, requete) {
  return sbRequete(cfg, '/rest/v1/' + table + '?' + requete);
}

function sbInsert(cfg, table, ligne) {
  return sbRequete(cfg, '/rest/v1/' + table, {
    method: 'POST',
    headers: { Prefer: 'return=representation' },
    body: ligne
  });
}

function sbUpdate(cfg, table, requete, patch) {
  return sbRequete(cfg, '/rest/v1/' + table + '?' + requete, {
    method: 'PATCH',
    headers: { Prefer: 'return=representation' },
    body: patch
  });
}

function sbDelete(cfg, table, requete) {
  return sbRequete(cfg, '/rest/v1/' + table + '?' + requete, { method: 'DELETE' });
}

function sbRpc(cfg, nom, args) {
  return sbRequete(cfg, '/rest/v1/rpc/' + nom, { method: 'POST', body: args || {} });
}

/* Journal des echanges avec le prestataire. Ne fait JAMAIS echouer
   l'operation principale : une trace perdue vaut mieux qu'un paiement
   bloque. En revanche elle n'est jamais silencieuse cote logs Netlify. */
async function journaliser(cfg, paymentId, evenement, details) {
  details = details || {};
  try {
    await sbInsert(cfg, 'payment_events', {
      payment_id: paymentId || null,
      event: evenement,
      http_status: typeof details.httpStatus === 'number' ? details.httpStatus : null,
      message: details.message ? String(details.message).slice(0, 1000) : null,
      payload: details.payload || null
    });
  } catch (e) {
    console.error('[paiement] journalisation impossible (' + evenement + ') :', e.message);
  }
}

/* --------------------------------------------------------------------
   Identite de l'appelant
   -------------------------------------------------------------------- */

/* Verifie le jeton d'acces Supabase envoye par le navigateur. On ne se
   contente jamais d'un user_id transmis dans le corps de la requete :
   il serait trivialement falsifiable. */
async function utilisateurDepuisJeton(cfg, enteteAuth) {
  const brut = enteteAuth || '';
  const m = /^Bearer\s+(.+)$/i.exec(brut.trim());
  if (!m) return null;
  try {
    const rep = await fetchAvecDelai(cfg.supabaseUrl + '/auth/v1/user', {
      method: 'GET',
      headers: { apikey: cfg.serviceKey, Authorization: 'Bearer ' + m[1] }
    }, 10000);
    if (!rep.ok) return null;
    const u = await rep.json();
    return (u && u.id) ? u : null;
  } catch (e) {
    return null;
  }
}

/* --------------------------------------------------------------------
   References
   -------------------------------------------------------------------- */

/* Reference visible par l'utilisateur (affichee a l'ecran, citee au
   support). L'ancien format VB-AAAAMM-1234 n'offrait que 9000 valeurs par
   mois pour une colonne UNIQUE : les collisions etaient inevitables. */
function genererReferenceClient() {
  const d = new Date();
  const mois = d.getUTCFullYear() + String(d.getUTCMonth() + 1).padStart(2, '0');
  return 'VB-' + mois + '-' + crypto.randomBytes(4).toString('hex').toUpperCase();
}

/* Reference envoyee au prestataire. VOLONTAIREMENT DIFFERENTE de celle
   ci-dessus et JAMAIS renvoyee au navigateur : l'API de creation
   n'exige que le client_id (aucun secret). Si quelqu'un connaissait a la
   fois le client_id et cette reference, il pourrait creer lui-meme une
   transaction de 20 HTG dessus et faire confirmer un plan a 2900 HTG. */
function genererReferencePrestataire() {
  return 'VBP-' + Date.now().toString(36).toUpperCase() + '-' +
         crypto.randomBytes(8).toString('hex').toUpperCase();
}

/* --------------------------------------------------------------------
   Appels au prestataire
   -------------------------------------------------------------------- */

async function appelerPrestataire(cfg, chemin, corps) {
  const rep = await fetchAvecDelai(cfg.ppBaseUrl + chemin, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
    body: JSON.stringify(corps)
  }, 20000);
  const texte = await rep.text();
  let json = null;
  if (texte) { try { json = JSON.parse(texte); } catch (e) { json = null; } }
  return { httpStatus: rep.status, ok: rep.ok, json: json, texte: texte.slice(0, 1000) };
}

function creerTransaction(cfg, referencePrestataire, montant, methode) {
  return appelerPrestataire(cfg, '/api/paiement-marchand', {
    client_id: cfg.ppClientId,
    refference_id: referencePrestataire,
    montant: montant,
    payment_method: methode
  });
}

function verifierTransaction(cfg, referencePrestataire) {
  return appelerPrestataire(cfg, '/api/paiement-verify', {
    client_id: cfg.ppClientId,
    refference_id: referencePrestataire
  });
}

/* --------------------------------------------------------------------
   Coeur : verification + confirmation d'un paiement
   ---------------------------------------------------------------------
   Utilise a l'identique par paiement-verify (retour de l'utilisateur sur
   le site) et par le poller planifie. Un seul chemin, donc aucune
   divergence possible entre les deux.

   Retourne toujours un objet { etat, code, ... } — jamais d'exception
   pour un refus metier, les exceptions restent reservees aux pannes.
   -------------------------------------------------------------------- */
async function verifierEtConfirmer(cfg, paiement) {
  if (!paiement || !paiement.provider_reference) {
    return { etat: 'erreur', code: 'SANS_REFERENCE_PRESTATAIRE' };
  }

  if (paiement.status === 'confirmed') {
    return { etat: 'confirme', code: 'ALREADY_CONFIRMED' };
  }
  if (paiement.status !== 'pending') {
    return { etat: 'clos', code: 'NOT_PENDING', status: paiement.status };
  }

  let rep;
  try {
    rep = await verifierTransaction(cfg, paiement.provider_reference);
  } catch (e) {
    await journaliser(cfg, paiement.id, 'verify_error', { message: e.message });
    return { etat: 'erreur', code: 'PRESTATAIRE_INJOIGNABLE', message: e.message };
  }

  await journaliser(cfg, paiement.id, 'verify_response', {
    httpStatus: rep.httpStatus,
    payload: rep.json || { brut: rep.texte }
  });

  if (!rep.ok || !rep.json) {
    return { etat: 'erreur', code: 'REPONSE_PRESTATAIRE_INVALIDE', httpStatus: rep.httpStatus };
  }

  const d = rep.json;
  const statutTrans = String(d.trans_status || '').toLowerCase();

  /* Trace du dernier controle, meme quand rien n'a change : c'est ce qui
     permet de voir, en cas de litige, que le systeme a bien interroge le
     prestataire et ce qu'il a repondu. */
  const patch = {
    provider_checked_at: new Date().toISOString(),
    provider_status: statutTrans || null,
    provider_payload: d
  };
  if (d.id_transaction) patch.provider_transaction_id = String(d.id_transaction);
  try {
    await sbUpdate(cfg, 'payments', 'id=eq.' + paiement.id, patch);
  } catch (e) {
    console.error('[paiement] maj trace verification impossible :', e.message);
  }

  if (statutTrans !== 'ok') {
    return { etat: 'attente', code: 'TRANS_STATUS_' + (statutTrans || 'INCONNU').toUpperCase() };
  }

  /* Confirmation reelle. Le controle du montant et de la methode est
     refait A L'INTERIEUR de la RPC, sur des colonnes que le navigateur ne
     peut pas ecrire (trigger payments_protect_provider_cols). Ce que l'on
     transmet ici ne peut donc jamais servir a contourner le controle. */
  let res;
  try {
    res = await sbRpc(cfg, 'confirmer_paiement_prestataire', {
      p_payment_id: paiement.id,
      p_transaction_id: d.id_transaction ? String(d.id_transaction) : null,
      p_provider_amount: (d.montant === null || d.montant === undefined) ? null : Number(d.montant),
      p_provider_method: d.method ? String(d.method) : null,
      p_payload: d
    });
  } catch (e) {
    await journaliser(cfg, paiement.id, 'confirm_error', { message: e.message });
    return { etat: 'erreur', code: 'RPC_ECHEC', message: e.message };
  }

  await journaliser(cfg, paiement.id, 'confirm', { payload: res });

  if (res && res.ok) {
    return { etat: 'confirme', code: res.code || 'CONFIRMED', detail: res };
  }
  return { etat: 'refuse', code: (res && res.code) || 'REFUS_INCONNU', detail: res };
}

module.exports = {
  METHODES_AUTORISEES,
  MONTANT_MINIMUM_PRESTATAIRE,
  lireConfig,
  reponseJson,
  fetchAvecDelai,
  sbRequete,
  sbSelect,
  sbInsert,
  sbUpdate,
  sbDelete,
  sbRpc,
  journaliser,
  utilisateurDepuisJeton,
  genererReferenceClient,
  genererReferencePrestataire,
  creerTransaction,
  verifierTransaction,
  verifierEtConfirmer
};
